===== CONFIGURACIÓN DE RED =====
# Configuración automática (RECOMENDADO)
# Deja estas líneas comentadas para auto-detección
# SERVER_HOST=auto
# SERVER_IP=0.0.0.0

# Configuración manual (configurada para tu red específica)
#SERVER_HOST=192.168.1.121
#SERVER_IP=192.168.1.121

# Puerto del servidor
PORT=3000

# Forzar uso de MCP por defecto
USE_MCP=true 

# Configuración para debugging 
WEBHOOK_ENABLED=false 
DEBUG_MODE=false 

# ===== BASE DE DATOS =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=monito

# Configuración de Gemini
GEMINI_API_KEY_1=AIzaSyAVlC6rF2hLQU9O6gyrcHEfvsWCm0wbjx8
GEMINI_API_KEY_2=AIzaSyAR9qiIwgIC8IsecHAAsRJlz0dFknndI14
GEMINI_API_KEY_3=AIzaSyDtg1bnCSpwNqxrn1x5HcKCMrZ2cqeEnBA

# ===== CONFIGURACIÓN DE ENTORNO =====
NODE_ENV=development
TZ=America/Caracas

# ===== SEGURIDAD =====
JWT_SECRET=monito

# ===== CONFIGURACIÓN DE UPLOADS =====
# UPLOAD_BASE_URL se genera automáticamente basado en SERVER_HOST

# Configuración del Cliente Flutter - Le Brunch App
# Este archivo es OPCIONAL - el sistema funciona perfectamente sin él

# URL por defecto del servidor (se auto-detecta si no se especifica)
# Descomenta y ajusta si quieres forzar una URL específica
#BASE_URL=http://192.168.1.121:3000

# Configuración de desarrollo
#DEBUG_MODE=true
#ENABLE_LOGGING=true

# Timeouts de red (en segundos)
#CONNECTION_TIMEOUT=10
#READ_TIMEOUT=30

# Cache y persistencia
#ENABLE_CACHE=true
#CACHE_DURATION_HOURS=24

# Configuración de audio
#AUDIO_MAX_DURATION=60
#ENABLE_AUDIO_RECORDING=true