# ===============================================
# 🌐 Configuración de Red - Le Brunch App
# ===============================================

# IP del servidor (OPCIONAL - se auto-detecta si no se especifica)
#SERVER_HOST=192.168.1.121

# Puerto del servidor (por defecto: 3000)
PORT=3000

# ===============================================
# 🤖 Configuración de Gemini AI
# ===============================================

# Claves API de Gemini (se usan con rotación automática)
GEMINI_API_KEY_1=AIzaSy...tu_primera_clave_aqui
GEMINI_API_KEY_2=AIzaSy...tu_segunda_clave_aqui  
GEMINI_API_KEY_3=AIzaSy...tu_tercera_clave_aqui

# ===============================================
# 🗄️ Configuración de Base de Datos
# ===============================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=le_brunch_db
DB_USER=postgres
DB_PASSWORD=monito

# ===============================================
# 📝 Notas de Configuración
# ===============================================

# 1. SERVER_HOST: Si no se especifica, el servidor auto-detecta su IP local
# 2. Las claves de Gemini se rotan automáticamente para evitar límites de API
# 3. La app Flutter encuentra el servidor automáticamente en la red local
# 4. Usa el diagnóstico de red en la app para debugging de conexión

# ===============================================
# 🚀 Instrucciones de Uso
# ===============================================

# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Reemplaza las claves de Gemini con las tuyas reales
# 3. Ajusta la configuración de DB si usas valores diferentes
# 4. Ejecuta: cd servidor && node servidor.js
# 5. La app Flutter se conectará automáticamente al servidor 