{
  "nodes": [
    {
      "parameters": {
        "path": "chat-process",
        "method": "POST",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "const { userId, message, currentCart } = $input.all();\n\n// Consultar historial (simplificado)\nconst historialQuery = `SELECT mensaje, respuesta FROM historial_chat WHERE IDpersona = ${userId} ORDER BY fecha DESC LIMIT 3`;\nconst historial = await $getPostgresQuery(historialQuery);\n\nreturn {\n  prompt: `Contexto:\\n1. Historial:\\n${historial.map(m => `- ${m.mensaje || m.respuesta}`).join('\\n')}\\n2. Carrito actual: ${JSON.stringify(currentCart)}\\n\\nMensaje nuevo: \"${message}\"`,\n  userId,\n  message\n};"
      },
      "name": "Preparar Contexto",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "agent": "zero-shot-react-description",
        "model": {
          "source": "credential",
          "credentialType": "ollamaApi"
        },
        "prompt": "Eres \"Le Brunch Assistant\". Responde en JSON con: { \"action\": \"add_to_cart|answer\", \"responseText\": \"...\", \"item\": { \"name\": \"...\" }, \"suggestions\": [...] }",
        "tools": [
          {
            "name": "query_menu",
            "description": "Consultar disponibilidad de platos",
            "parameters": {
              "type": "object",
              "properties": {
                "plato": { "type": "string" }
              }
            }
          }
        ]
      },
      "name": "LangChain Agent",
      "type": "n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "ollamaApi": "Ollama"
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT nombre, precio, img_url FROM menu WHERE nombre ILIKE '%{{ $json.item.name }}%' AND disponibilidad = true;"
      },
      "name": "PostgreSQL - Menú",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "postgres": "PostgreSQL"
      }
    },
    {
      "parameters": {
        "functionCode": "const aiResponse = $input.all();\nconst dbResult = $node[\"PostgreSQL - Menú\"].json;\n\nif (aiResponse.action.includes(\"_to_cart\") && dbResult.length === 0) {\n  return {\n    action: \"answer\",\n    responseText: `\"${aiResponse.item?.name}\" no disponible. Prueba con:`,\n    suggestions: [\"Waffles Belgas\", \"Tostadas Francesas\"]\n  };\n}\n\nreturn { ...aiResponse, item: dbResult[0] };"
      },
      "name": "Validar Respuesta",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO historial_chat (IDpersona, mensaje, respuesta) VALUES ({{ $json.userId }}, '{{ $json.message }}', '{{ $node[\"Validar Respuesta\"].json[\"responseText\"] }}');"
      },
      "name": "PostgreSQL - Historial",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": {
        "postgres": "PostgreSQL"
      }
    },
    {
      "parameters": {},
      "name": "Respuesta HTTP",
